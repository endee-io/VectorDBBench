# Settings for every database in db_setup/ - edit here, then restart the database:
#   ./db.sh stop <db> && ./db.sh start <db>
# db.sh passes this file to docker compose (--env-file), so each value below ends up in <db>/docker-compose.yml.

# ---- Network ---------------------------------------------------------------------------------------------------
# Every port is published only on localhost and on this IP (the server's PRIVATE IP that the benchmark client uses).
BIND_IP=CHANGE_ME              # e.g. 10.0.1.23 - this server's private IP (hostname -I)

# ---- Versions (Docker images) ---------------------------------------------------------------------------------
# These are the exact versions all our benchmark results were measured with - keep them for comparable results.
# To try another version: change it here, then ./db.sh stop <db> && ./db.sh start <db>   (./db.sh versions shows newer ones)
MILVUS_IMAGE=milvusdb/milvus:v3.0.5
MILVUS_ETCD_IMAGE=quay.io/coreos/etcd:v3.5.25
MILVUS_MINIO_IMAGE=milvusdb/minio:RELEASE.2024-12-18T13-15-44Z
QDRANT_IMAGE=qdrant/qdrant:v1.20.0
REDIS_IMAGE=redis:8.10.3
VESPA_IMAGE=vespaengine/vespa:8.781.11

# ---- Redis -----------------------------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME       # pick a password; use the same one in the benchmark's --password
# Snapshot rules (write dump.rdb after N seconds if M keys changed). Default Redis rules: "3600 1 300 100 60 10000".
# For very large loads (e.g. 10M vectors) set REDIS_SAVE="" : background snapshots fork the process and can double
# its memory for a moment. The benchmark runner saves explicitly (SAVE) before it stops Redis anyway.
REDIS_SAVE=3600 1 300 100 60 10000

# ---- Milvus ----------------------------------------------------------------------------------------------------
# MinIO = Milvus' object storage (only reachable through BIND_IP / localhost)
MINIO_ACCESS_KEY=minioadmin     # any name (Milvus gets the same value)
MINIO_SECRET_KEY=minioadmin   # at least 8 characters (MinIO rule)
# Extra Milvus settings go in milvus/user.yaml (mounted as /milvus/configs/user.yaml, overrides milvus.yaml),
# e.g. a larger segment size so float32 1M collections end up in one segment.

# ---- Qdrant ----------------------------------------------------------------------------------------------------
QDRANT_NOFILE=65535          # open-files limit (Qdrant keeps many segment files open)
